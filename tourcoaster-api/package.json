{
  "name": "tourcoaster-api",
  "version": "0.1.0",
  "private": true,
  "description": "TourCoaster Cloudflare Workers API (Hono + D1 + KV + R2).",
  "main": "src/index.ts",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "db:migrate:local": "wrangler d1 migrations apply tourcoaster --local",
    "db:migrate:remote": "wrangler d1 migrations apply tourcoaster --remote",
    "db:studio:local": "wrangler d1 execute tourcoaster --local --command \"SELECT name FROM sqlite_master WHERE type='table' ORDER BY name;\"",
    "lint": "eslint \"src/**/*.ts\"",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "hono": "^4.6.14",
    "jose": "^6.2.3"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20241218.0",
    "@typescript-eslint/eslint-plugin": "^8.18.2",
    "@typescript-eslint/parser": "^8.18.2",
    "eslint": "^9.17.0",
    "typescript": "^5.7.2",
    "wrangler": "^3.99.0"
  }
}
